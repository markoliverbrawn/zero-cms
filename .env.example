DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cms
DB_USER=root
DB_PASS=
ENVIRONMENT=production
ADMIN_USER=admin
ADMIN_PASS=change_me
BASE_URL=http://localhost

# Full Platform Performance Benchmarking (set to 'true' to display DB & total request stats overlay)
BENCHMARKING=false

# Storage Configuration
STORAGE_DRIVER=local
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEY_FILE=/path/to/gcs-key.json

# Google OAuth 2.0 Credentials (for "Login with Google")
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://d6laptop.zero/admin/google-callback

# Job Queue Web-Fallback trigger security authorization token
QUEUE_TRIGGER_TOKEN=your_secure_random_hex_trigger_token

# Application signing key, used to sign on-demand image variant URLs so only renditions the CMS
# itself minted can ever be generated. Generate with: php -r "echo bin2hex(random_bytes(32));"
# If left blank a stable key is derived from the database and base URL configuration instead, so
# an existing installation keeps working -- but setting an explicit value is strongly preferred.
# Changing this invalidates every cached image variant; they regenerate on next request.
APP_KEY=

# Google Cloud Storage Predefined ACL (use 'publicRead' for Fine-Grained buckets, leave empty for Uniform buckets)
GCS_PREDEFINED_ACL=publicRead

# AWS S3 Storage Configurations (active only when STORAGE_DRIVER=s3)
AWS_S3_BUCKET=your_s3_bucket_name_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
