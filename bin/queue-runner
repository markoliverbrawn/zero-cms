#!/usr/bin/env php
<?php
// bin/queue-runner - CLI daemon background worker for Zero CMS Job Queue

define('APPLICATION_ROOT', dirname(__DIR__));

// Register the Zero\ namespace via Core's own Autoloader class rather than a hand-rolled
// closure, since a sub-project checkout also needs App\ registered below.
require_once APPLICATION_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();

use Zero\Core\App;
use Zero\Core\Env;
use Zero\Core\Storage\Storage;
use Zero\Modules\Queue\Support\QueueManager;

// When this is the vendored copy inside a sub-project (vendor/markoliverbrawn/zero-cms-core),
// also autoload the sub-project's own App\ namespace and register its module path -- mirrors
// bin/seed. Without this, job classes and scheduled tasks defined by sub-project modules can
// never be resolved (class_exists() always fails) or discovered by App::bootstrap().
$envRoot = APPLICATION_ROOT;
$vendorSuffix = '/vendor/markoliverbrawn/zero-cms-core';
if (\substr(APPLICATION_ROOT, -\strlen($vendorSuffix)) === $vendorSuffix) {
    $envRoot = \dirname(APPLICATION_ROOT, 3);
    \Zero\Core\Autoloader::registerNamespace('App\\', $envRoot . '/src');
    App::registerModulePath($envRoot . '/src/Modules', 'App\\Modules\\');
}

// Pre-hydrate environment configuration from correct root path
Env::load($envRoot);

// Keep local storage (uploads, private files) inside the sub-project's own root rather than the
// read-only vendor package -- matches public/index.php and bin/seed's Storage::setRoot() call.
Storage::setRoot($envRoot);

// Bootstrap Zero CMS kernel
App::bootstrap();

echo "==================================================\n";
echo "       ZERO CMS BACKEND QUEUE DAEMON WORKER       \n";
echo "==================================================\n";
echo "--> Active Database: " . Env::get('DB_NAME') . "\n";
echo "--> Polling Interval: 100ms\n";
echo "--> Daemon Process ID: " . getmypid() . "\n";
echo "--> Running as user: " . posix_getpwuid(posix_getuid())['name'] . "\n";
echo "--------------------------------------------------\n";
echo "Daemon started. Listening for pending tasks...\n\n";

$lastHeartbeat = 0;
$heartbeatPath = $envRoot . '/storage/queue-worker-heartbeat.txt';

while (true) {
    try {
        // Real-time heartbeat touching once every 10 seconds
        if (time() - $lastHeartbeat >= 10) {
            touch($heartbeatPath);
            $lastHeartbeat = time();
        }

        // Run next pending or expired locked job
        $processed = QueueManager::runNextPendingJob();
        
        if (!$processed) {
            // No jobs to process, sleep 100ms to conserve CPU cycles
            usleep(100000);
        }
    } catch (\Throwable $e) {
        echo "[" . date('Y-m-d H:i:s') . "] Critical runner error: " . $e->getMessage() . "\n";
        sleep(2); // Cool down after critical exceptions to prevent rapid spam loops
    }
}
