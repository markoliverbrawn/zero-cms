#!/usr/bin/env php
<?php
// bin/check-commit-messages - Validates that every commit in a given range follows the
// Conventional Commits format bin/release depends on to compute the next semantic version. Run
// in CI against a pull request's commit range so a malformed subject line is caught before merge,
// rather than silently producing "nothing to release" after the fact.
//
// Usage: bin/check-commit-messages <git-range>   e.g. bin/check-commit-messages origin/main..HEAD

declare(strict_types=1);

define('APPLICATION_ROOT', dirname(__DIR__));

$range = $argv[1] ?? null;
if ($range === null) {
    fwrite(STDERR, "Usage: bin/check-commit-messages <git-range>\n");
    exit(2);
}

/**
 * Run a shell command from the repository root and return its trimmed stdout, exiting
 * immediately with the same code (after echoing stderr) if the command itself fails.
 */
function run(string $cmd): string
{
    $descriptors = [1 => ['pipe', 'w'], 2 => ['pipe', 'w']];
    $process = proc_open($cmd, $descriptors, $pipes, APPLICATION_ROOT);
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        fwrite(STDERR, $stderr);
        exit($exitCode);
    }
    return trim($stdout);
}

$validTypes = ['feat', 'fix', 'perf', 'refactor', 'docs', 'chore', 'test', 'build', 'ci', 'style', 'revert'];

$log = run("git log {$range} --pretty=format:%h%x01%s");
if ($log === '') {
    echo "No commits in range {$range}.\n";
    exit(0);
}

$failures = [];
foreach (explode("\n", $log) as $line) {
    [$hash, $subject] = array_pad(explode("\x01", $line, 2), 2, '');
    if (preg_match('/^Merge /', $subject)) {
        continue; // Merge commits are exempt -- they're generated by GitHub, not authored.
    }
    if (!preg_match('/^([a-zA-Z]+)(\(([^)]+)\))?(!)?:\s*.+$/', $subject, $m)) {
        $failures[] = "{$hash} \"{$subject}\" -- doesn't match \"type(scope): description\"";
        continue;
    }
    if (!in_array(strtolower($m[1]), $validTypes, true)) {
        $failures[] = "{$hash} \"{$subject}\" -- unknown type \"{$m[1]}\" (expected one of: " . implode(', ', $validTypes) . ')';
    }
}

if (!empty($failures)) {
    fwrite(STDERR, "Commit message convention violations found:\n\n");
    foreach ($failures as $failure) {
        fwrite(STDERR, "  - {$failure}\n");
    }
    fwrite(STDERR, "\nSee https://www.conventionalcommits.org/ -- bin/release parses these to compute the next semantic version.\n");
    exit(1);
}

echo "All commit messages in {$range} follow the Conventional Commits format.\n";
