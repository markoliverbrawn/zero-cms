// Parse CLI scale multiplier
$scale = 1;
foreach ($argv as $arg) {
    if (strpos($arg, '--scale=') === 0) {
        $scale = max(1, intval(substr($arg, 8)));
    }
}

echo "--> Target: Kitchen Sink Showroom ('d6laptop.zero.kitchensink')\n";
echo "--> Scale Multiplier: {$scale}x\n\n";

// Resolve active site ID
$siteId = App::getCurrentSiteId();
if (!$siteId) {
    echo "Error: Kitchen Sink site not found in database. Please run standard seeders first!\n";
    exit(1);
}

// Resolve active author/user ID
$user = DB::query("SELECT id FROM users WHERE site_id = ? OR role = 'super_admin' LIMIT 1", [$siteId])->fetch();
$userId = $user ? $user['id'] : Security::uuidv7();

// Retrieve all available media assets in the database for this site
$mediaRows = DB::query("SELECT id, path, filename FROM media WHERE site_id = ? AND mime LIKE 'image/%' AND path != ''", [$siteId])->fetchAll();
if (empty($mediaRows)) {
    echo "Warning: No media records found for this site. Using fallback default icons.\n";
    $mediaRows = [['id' => null, 'path' => '/assets/svgs/image.svg', 'filename' => 'image.svg']];
}

// --------------------------------------------------
// PROCEDURAL DATA DICTIONARIES
// --------------------------------------------------
$prefixes = ['Quantum', 'Neon', 'Graphene', 'Nanite', 'Holographic', 'Bio-Linked', 'Synthetic', 'Neural', 'Cryo-Cooler', 'Obsidian', 'Tactile', 'Sub-Zero', 'Carbon', 'Cyberware', 'Solid-State', 'Neuro-Voxel', 'Hyper-Optic', 'Sonic', 'Tox-Shield', 'Pulsar'];
$adjectives = ['Tactical', 'Sleek', 'Mechanical', 'Modular', 'Premium', 'Handcrafted', 'Brutalist', 'Geometric', 'Minimalist', 'Curated', 'Bespoke', 'Sub-Orbital', 'High-Contrast', 'Linear', 'Fluid', 'Static', 'Autonomous', 'Reinforced', 'Cryogenic'];
$nouns = ['Deck Console', 'Exoskeleton Arm', 'HUD Glasses', 'Cyber Vest', 'Wrist Strap', 'Core Interface', 'Pulsar Injector', 'Neuro-Drive', 'Thermal Shirt', 'Utility Belt', 'Maintenance Pack', 'Cyber Gloves', 'Cooler Module', 'Neuro-Linker', 'Vessel', 'Clay Burner', 'Trench Coat'];
$actions = ['optimize neural bandwidth', 'bypass secure firewall protocols', 'reduce packet latency in satellite relays', 'resolve checkout concurrency race conditions', 'mitigate XSS injection exploits recursively', 'sign cryptographic SigV4 header requests natively', 'serialize complex JSON page layouts in-memory', 'prevent N+1 database queries via LEFT JOIN queries', 'enforce zero-dependency secure socketSMTP dispatches', 'minimize CPU execution times in raw recursive searches'];

// --------------------------------------------------
// PROCEDURAL HELPER FUNCTIONS
// --------------------------------------------------

/**
 * High-speed SQL batch insertion utility.
 * Compiles hundreds of rows into a single multi-value INSERT query.
 */
function batchInsert(string $table, array $columns, array $rows)
{
    if (empty($rows)) {
        return;
    }

    $colsSql = implode(', ', $columns);
    $placeholders = [];
    $values = [];

    foreach ($rows as $row) {
        $rowPlaceholders = [];
        foreach ($columns as $col) {
            $val = $row[$col] ?? null;
            if ($val === 'NOW()' || $val === 'UUID()') {
                $rowPlaceholders[] = $val;
            } else {
                $rowPlaceholders[] = '?';
                if (is_array($val)) {
                    $values[] = json_encode($val);
                } else {
                    $values[] = $val;
                }
            }
        }
        $placeholders[] = '(' . implode(', ', $rowPlaceholders) . ')';
    }

    $sql = "INSERT INTO {$table} ({$colsSql}) VALUES " . implode(', ', $placeholders);
    DB::query($sql, $values);
}

function generateTitle()
{
    global $prefixes, $adjectives, $nouns;
    return $prefixes[array_rand($prefixes)] . ' ' . $adjectives[array_rand($adjectives)] . ' ' . $nouns[array_rand($nouns)];
}

function generateContent(string $title)
{
    global $actions;
    $action1 = $actions[array_rand($actions)];
    $action2 = $actions[array_rand($actions)];
    return "<p>The " . $title . " represents a masterclass in modern brutalist engineering. It is specifically designed to " . $action1 . " and " . $action2 . ".</p>";
}

// --------------------------------------------------
// IDEMPOTENT PRUNING (Clear previous runs safely)
// --------------------------------------------------
echo "--> Safely clearing previous mass-seeded records inside tenant boundaries...\n";
DB::query("DELETE FROM shop_product_variants WHERE site_id = ?", [$siteId]);
DB::query("DELETE FROM shop_product_category_links WHERE site_id = ?", [$siteId]);
DB::query("DELETE FROM shop_products WHERE site_id = ? AND sku LIKE 'KITCH-%'", [$siteId]);
DB::query("DELETE FROM shop_categories WHERE site_id = ?", [$siteId]);
DB::query("DELETE FROM pages WHERE site_id = ? AND slug LIKE 'page-%'", [$siteId]);
