// --------------------------------------------------
// SEEDING STAGE 1: SHOP PRODUCTS (500 * scale)
// --------------------------------------------------
$productCount = 500 * $scale;
echo "1. Seeding {$productCount} unique e-commerce products with custom SKUs, pricing, and multi-category linkages...\n";

$productRows = [];
$variantRows = [];
$categoryLinkRows = [];

$columns = ['id', 'site_id', 'category_id', 'title', 'slug', 'sku', 'description', 'price', 'compare_at_price', 'main_image', 'status', 'exclude_from_search', 'created_at', 'updated_at'];
$variantCols = ['id', 'site_id', 'product_id', 'title', 'sku', 'price', 'stock', 'created_at', 'updated_at'];
$linkCols = ['product_id', 'category_id', 'site_id'];

for ($i = 0; $i < $productCount; $i++) {
    $pId = Security::uuidv7();
    $title = generateTitle() . ' ' . ($i + 1);
    $slug = App::slugify($title);
    $sku = 'KITCH-' . strtoupper(substr(md5($title), 0, 8)) . '-' . ($i + 1);
    $desc = generateContent($title);
    $price = rand(15, 1200) + (rand(0, 99) / 100);
    $comparePrice = rand(0, 1) ? $price * 1.2 : null;

    // Primary Category Legacy Assignment
    $catId = $categoryIds[array_rand($categoryIds)];

    $media = $mediaRows[array_rand($mediaRows)];
    $mainImage = $media['id'] ?? $media['path']; // ID string or path

    $productRows[] = [
        'id' => $pId,
        'site_id' => $siteId,
        'category_id' => $catId,
        'title' => $title,
        'slug' => $slug,
        'sku' => $sku,
        'description' => $desc,
        'price' => $price,
        'compare_at_price' => $comparePrice,
        'main_image' => $mainImage,
        'status' => 'published',
        'exclude_from_search' => 0,
        'created_at' => gmdate('Y-m-d H:i:s'),
        'updated_at' => gmdate('Y-m-d H:i:s')
    ];

    // Seed 2 product variants for each product
    for ($v = 1; $v <= 2; $v++) {
        $vId = Security::uuidv7();
        $vTitle = "Standard Edition V{$v}";
        $vSku = $sku . "-V{$v}";
        $variantRows[] = [
            'id' => $vId,
            'site_id' => $siteId,
            'product_id' => $pId,
            'title' => $vTitle,
            'sku' => $vSku,
            'price' => $price,
            'stock' => rand(5, 100),
            'created_at' => gmdate('Y-m-d H:i:s'),
            'updated_at' => gmdate('Y-m-d H:i:s')
        ];
    }

    // Select 2 unique random categories for many-to-many linkages
    $shuffledCats = $categoryIds;
    shuffle($shuffledCats);
    $selectedCats = array_slice($shuffledCats, 0, 2);

    foreach ($selectedCats as $selectedCatId) {
        $categoryLinkRows[] = [
            'product_id' => $pId,
            'category_id' => $selectedCatId,
            'site_id' => $siteId
        ];
    }

    // High-speed write flushing in chunks of 100
    if (count($productRows) >= 100) {
        batchInsert('shop_products', $columns, $productRows);
        batchInsert('shop_product_variants', $variantCols, $variantRows);
        batchInsert('shop_product_category_links', $linkCols, $categoryLinkRows);
        $productRows = [];
        $variantRows = [];
        $categoryLinkRows = [];
    }
}
// Flush remaining
batchInsert('shop_products', $columns, $productRows);
batchInsert('shop_product_variants', $variantCols, $variantRows);
batchInsert('shop_product_category_links', $linkCols, $categoryLinkRows);

