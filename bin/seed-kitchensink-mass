    $cId = Security::uuidv7();
    $cSlug = App::slugify($cName);
    $cDesc = "High-precision technical repository of premium {$cName} components designed to optimize performance.";
    $media = $mediaRows[array_rand($mediaRows)];
    $cImage = $media['id'] ?? $media['path'];

    $categoryRows[] = [
        'id' => $cId,
        'site_id' => $siteId,
        'title' => $cName,
        'slug' => $cSlug,
        'description' => $cDesc,
        'image' => $cImage,
        'created_at' => gmdate('Y-m-d H:i:s'),
        'updated_at' => gmdate('Y-m-d H:i:s')
    ];
    $categoryIds[] = $cId;
}
