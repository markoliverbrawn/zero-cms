#!/usr/bin/env php
<?php
// bin/seed-kitchensink-mass - High-performance procedural mass content generator for the
// kitchensink demo/theme-showcase site.

define('APPLICATION_ROOT', dirname(__DIR__));

require_once APPLICATION_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();

use Zero\Core\App;
use Zero\Core\Env;
use Zero\Database\DB;
use Zero\Modules\Search\Services\SearchService;
use Zero\Support\Security;

// Mock HTTP_HOST before bootstrap to ensure correct multi-tenant context loading
$_SERVER['HTTP_HOST'] = 'd6laptop.zero.kitchensink';

Env::load(APPLICATION_ROOT);
App::bootstrap();

echo "====================================================================\n";
echo "ZERO CMS HIGH-PERFORMANCE PROCEDURAL MASS SEEDER SYSTEM\n";
echo "====================================================================\n";

// Parse CLI scale multiplier
$scale = 1;
foreach ($argv as $arg) {
    if (strpos($arg, '--scale=') === 0) {
        $scale = max(1, intval(substr($arg, 8)));
    }
}

echo "--> Target: Kitchen Sink Showroom ('d6laptop.zero.kitchensink')\n";
echo "--> Scale Multiplier: {$scale}x\n\n";

// Resolve active site ID
$siteId = App::getCurrentSiteId();
if (!$siteId) {
    echo "Error: Kitchen Sink site not found in database. Please run standard seeders first!\n";
    exit(1);
}

// Resolve active author/user ID
$user = DB::query("SELECT id FROM users WHERE site_id = ? OR role = 'super_admin' LIMIT 1", [$siteId])->fetch();
$userId = $user ? $user['id'] : Security::uuidv7();

// Retrieve all available media assets in the database for this site
$mediaRows = DB::query("SELECT id, path, filename FROM media WHERE site_id = ? AND mime LIKE 'image/%' AND path != ''", [$siteId])->fetchAll();
if (empty($mediaRows)) {
    echo "Warning: No media records found for this site. Using fallback default icons.\n";
    $mediaRows = [['id' => null, 'path' => '/assets/svgs/image.svg', 'filename' => 'image.svg']];
}

// --------------------------------------------------
// PROCEDURAL DATA DICTIONARIES
// --------------------------------------------------
$prefixes = ['Quantum', 'Neon', 'Graphene', 'Nanite', 'Holographic', 'Bio-Linked', 'Synthetic', 'Neural', 'Cryo-Cooler', 'Obsidian', 'Tactile', 'Sub-Zero', 'Carbon', 'Cyberware', 'Solid-State', 'Neuro-Voxel', 'Hyper-Optic', 'Sonic', 'Tox-Shield', 'Pulsar'];
$adjectives = ['Tactical', 'Sleek', 'Mechanical', 'Modular', 'Premium', 'Handcrafted', 'Brutalist', 'Geometric', 'Minimalist', 'Curated', 'Bespoke', 'Sub-Orbital', 'High-Contrast', 'Linear', 'Fluid', 'Static', 'Autonomous', 'Reinforced', 'Cryogenic'];
$nouns = ['Deck Console', 'Exoskeleton Arm', 'HUD Glasses', 'Cyber Vest', 'Wrist Strap', 'Core Interface', 'Pulsar Injector', 'Neuro-Drive', 'Thermal Shirt', 'Utility Belt', 'Maintenance Pack', 'Cyber Gloves', 'Cooler Module', 'Neuro-Linker', 'Vessel', 'Clay Burner', 'Trench Coat'];
$actions = ['optimize neural bandwidth', 'bypass secure firewall protocols', 'reduce packet latency in satellite relays', 'resolve checkout concurrency race conditions', 'mitigate XSS injection exploits recursively', 'sign cryptographic SigV4 header requests natively', 'serialize complex JSON page layouts in-memory', 'prevent N+1 database queries via LEFT JOIN queries', 'enforce zero-dependency secure socketSMTP dispatches', 'minimize CPU execution times in raw recursive searches'];

// --------------------------------------------------
// PROCEDURAL HELPER FUNCTIONS
// --------------------------------------------------

/**
 * High-speed SQL batch insertion utility.
 * Compiles hundreds of rows into a single multi-value INSERT query.
 */
function batchInsert(string $table, array $columns, array $rows)
{
    if (empty($rows)) {
        return;
    }

    $colsSql = implode(', ', $columns);
    $placeholders = [];
    $values = [];

    foreach ($rows as $row) {
        $rowPlaceholders = [];
        foreach ($columns as $col) {
            $val = $row[$col] ?? null;
            if ($val === 'NOW()' || $val === 'UUID()') {
                $rowPlaceholders[] = $val;
            } else {
                $rowPlaceholders[] = '?';
                if (is_array($val)) {
                    $values[] = json_encode($val);
                } else {
                    $values[] = $val;
                }
            }
        }
        $placeholders[] = '(' . implode(', ', $rowPlaceholders) . ')';
    }

    $sql = "INSERT INTO {$table} ({$colsSql}) VALUES " . implode(', ', $placeholders);
    DB::query($sql, $values);
}

function generateTitle()
{
    global $prefixes, $adjectives, $nouns;
    return $prefixes[array_rand($prefixes)] . ' ' . $adjectives[array_rand($adjectives)] . ' ' . $nouns[array_rand($nouns)];
}

function generateContent(string $title)
{
    global $actions;
    $action1 = $actions[array_rand($actions)];
    $action2 = $actions[array_rand($actions)];
    return "<p>The " . $title . " represents a masterclass in modern brutalist engineering. It is specifically designed to " . $action1 . " and " . $action2 . ".</p>";
}

// --------------------------------------------------
// IDEMPOTENT PRUNING (Clear previous runs safely)
// --------------------------------------------------
echo "--> Safely clearing previous mass-seeded records inside tenant boundaries...\n";
DB::query("DELETE FROM pages WHERE site_id = ? AND slug LIKE 'page-%'", [$siteId]);
DB::query("DELETE FROM blog_posts WHERE site_id = ? AND slug LIKE 'post-%'", [$siteId]);



// --------------------------------------------------
// SEEDING STAGE 0: LAYOUT PAGES (300 * scale)
// --------------------------------------------------
$pageCount = 300 * $scale;
echo "0. Seeding {$pageCount} layout Pages with embedded Page Builder block arrays...\n";

$pageRows = [];
$pageCols = ['id', 'site_id', 'title', 'slug', 'content', 'summary', 'status', 'precedence', 'show_in_nav', 'exclude_from_search', 'created_at', 'updated_at'];

for ($i = 0; $i < $pageCount; $i++) {
    $pId = Security::uuidv7();
    $title = generateTitle() . ' Page ' . ($i + 1);
    $slug = 'page-' . App::slugify($title);
    $summary = "Technical specification page regarding the custom " . $title . " layout.";

    // Compile JSON page-builder block arrays containing varied block structures
    $blocks = [
        [
            'type' => 'hero',
            'title' => 'System Directive: ' . $title,
            'subtitle' => 'Brutalist Engineering Manual',
            'content' => generateContent($title)
        ],
        [
            'type' => 'accordion',
            'title' => 'Frequently Asked Diagnostics',
            'items' => [
                [
                    'title' => 'How do I initialize the ' . $title . '?',
                    'content' => '<p>Execute the bootstrapping protocol within terminal directories recursively.</p>'
                ],
                [
                    'title' => 'What is the packet latency threshold?',
                    'content' => '<p>Latency is optimized down to less than 1.2ms under deep network sockets.</p>'
                ]
            ]
        ]
    ];

    $pageRows[] = [
        'id' => $pId,
        'site_id' => $siteId,
        'title' => $title,
        'slug' => $slug,
        'content' => $blocks,
        'summary' => $summary,
        'status' => 'published',
        'precedence' => ($i + 1) * 10,
        'show_in_nav' => 0,
        'exclude_from_search' => 0,
        'created_at' => gmdate('Y-m-d H:i:s'),
        'updated_at' => gmdate('Y-m-d H:i:s')
    ];

    if (count($pageRows) >= 100) {
        batchInsert('pages', $pageCols, $pageRows);
        $pageRows = [];
    }
}
batchInsert('pages', $pageCols, $pageRows);

// --------------------------------------------------
// SEEDING STAGE 1: BLOG POSTS (300 * scale)
// --------------------------------------------------
$postCount = 300 * $scale;
echo "1. Seeding {$postCount} Blog Posts with rich cyberware keywords...\n";

$postRows = [];
$postCols = ['id', 'site_id', 'title', 'slug', 'content', 'summary', 'status', 'exclude_from_search', 'created_at', 'updated_at'];

for ($i = 0; $i < $postCount; $i++) {
    $pId = Security::uuidv7();
    $title = 'Hacker Netpost: ' . generateTitle() . ' (' . ($i + 1) . ')';
    $slug = 'post-' . App::slugify($title);
    $summary = "Technical bulletin detailing high-impact security telemetry regarding the new " . $title . " release.";
    $content = generateContent($title);

    $postRows[] = [
        'id' => $pId,
        'site_id' => $siteId,
        'title' => $title,
        'slug' => $slug,
        'content' => $content,
        'summary' => $summary,
        'status' => 'published',
        'exclude_from_search' => 0,
        'created_at' => gmdate('Y-m-d H:i:s'),
        'updated_at' => gmdate('Y-m-d H:i:s')
    ];

    if (count($postRows) >= 100) {
        batchInsert('blog_posts', $postCols, $postRows);
        $postRows = [];
    }
}
batchInsert('blog_posts', $postCols, $postRows);



// --------------------------------------------------
// FINALIZATION: GLOBAL INDEX REINDEXING
// --------------------------------------------------
echo "\n====================================================================\n";
echo "TRIGGERING BULK RE-INDEXING VIA THE DECOUPLED SERVICE...\n";
echo "====================================================================\n";
$start = microtime(true);
$reindexedCounts = SearchService::reindexAll();
$duration = round(microtime(true) - $start, 4);

echo "Successfully re-indexed all records in exactly {$duration} seconds!\n";
foreach ($reindexedCounts as $class => $count) {
    echo "   [Model: " . basename(str_replace('\\', '/', $class)) . "] Indexed: {$count} items\n";
}

$indexTotal = DB::query("SELECT COUNT(*) AS count FROM search_index WHERE site_id = ?", [$siteId])->fetch()['count'];
echo "Total active records in the Search Index table for this site: {$indexTotal}\n";
echo "====================================================================\n";
echo "HIGH-PERFORMANCE MASS SEEDING WORKFLOW COMPLETED WITH 100% SUCCESS!\n";
echo "====================================================================\n";
