    $pId = Security::uuidv7();
    $title = generateTitle() . ' Page ' . ($i + 1);
    $slug = 'page-' . App::slugify($title);
    $summary = "Technical specification page regarding the custom " . $title . " layout.";

    // Compile JSON page-builder block arrays containing varied block structures
    $blocks = [
        [
            'type' => 'hero',
            'title' => 'System Directive: ' . $title,
            'subtitle' => 'Brutalist Engineering Manual',
            'content' => generateContent($title)
        ],
        [
            'type' => 'accordion',
            'title' => 'Frequently Asked Diagnostics',
            'items' => [
                [
                    'title' => 'How do I initialize the ' . $title . '?',
                    'content' => '<p>Execute the bootstrapping protocol within terminal directories recursively.</p>'
                ],
