#!/bin/sh
# create-project
#
# Standalone bootstrapper: save this one file anywhere and run it on its own (no existing Zero
# CMS checkout required). It writes a composer.json into a new sub-project directory requiring
# Zero CMS Core from a private VCS repository and runs `composer install`, which pulls Core into
# vendor/markoliverbrawn/zero-cms-core/. It also lays down a basic public/src/bin/tests/storage
# folder structure for the sub-project's own files, and then deletes itself once the sub-project
# is fully scaffolded.
#
# Usage:
#   create-project <target-directory> [options]
#
# Options:
#   --branch <name>    Branch of Zero CMS Core to require (default: dev)
#   --remote <url>     Git remote URL of the Zero CMS Core VCS repository to require instead of
#                       the default Zero CMS Core repo
#   -h, --help         Show this help message
#
# Example:
#   create-project ../acme-website
#   create-project ../acme-website --branch main
#   create-project ../acme-website --remote git@github.com:acme/zero-fork.git --branch main

set -eu

# Resolve this script's own absolute path up front, before anything below can cd elsewhere --
# needed so the self-delete step at the end can find it reliably regardless of how deep the
# scaffolding process changes the working directory. Uses $0 (not bash's ${BASH_SOURCE[0]})
# so this runs under any POSIX sh (e.g. Alpine's ash/busybox), not just bash.
SELF_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

DEFAULT_REMOTE="git@github.com:markoliverbrawn/zero-cms.git"
PACKAGE_NAME="markoliverbrawn/zero-cms-core"
BRANCH="dev"
REMOTE="$DEFAULT_REMOTE"

usage() {
    sed -n '2,22p' "$SELF_PATH" | sed 's/^# \{0,1\}//'
}

# Scan all arguments first so -h/--help works no matter where it appears (including as the
# only argument), instead of blindly assuming $1 is always the target directory.
for arg in "$@"; do
    if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
        usage
        exit 0
    fi
done

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

if [ "${1#-}" != "$1" ]; then
    echo "Error: first argument must be the target directory, got option-like value: $1" >&2
    usage
    exit 1
fi

TARGET="$1"
shift

while [ $# -gt 0 ]; do
    case "$1" in
        --remote)
            REMOTE="$2"; shift 2 ;;
        --branch)
            BRANCH="$2"; shift 2 ;;
        *)
            echo "Unknown option: $1" >&2
            usage
            exit 1 ;;
    esac
done

if ! command -v git >/dev/null 2>&1; then
    echo "Error: git is required." >&2
    exit 1
fi

if ! command -v composer >/dev/null 2>&1; then
    echo "Error: composer is required." >&2
    exit 1
fi

# --- Safety check: never scaffold into an existing, non-empty directory ---
if [ -e "$TARGET" ] && [ -n "$(ls -A "$TARGET" 2>/dev/null)" ]; then
    echo "Error: '$TARGET' already exists and is not empty. Refusing to scaffold into it." >&2
    exit 1
fi

VENDOR_DIR="vendor/${PACKAGE_NAME}"

echo "==================================================================="
echo " Scaffolding new Zero CMS sub-project"
echo "==================================================================="
echo "  Target directory : $TARGET"
echo "  Core package     : ${PACKAGE_NAME} (from $REMOTE @ dev-${BRANCH})"
echo "==================================================================="
echo

mkdir -p "$TARGET"
TARGET="$(cd "$TARGET" && pwd)"

# --- 1. Initialize the outer git repo and require Core via Composer ---
if [ ! -d "$TARGET/.git" ]; then
    git -C "$TARGET" init -q
    echo "-> Initialized new git repository at $TARGET"
fi

echo "-> Writing $TARGET/composer.json requiring ${PACKAGE_NAME}"
cat > "$TARGET/composer.json" <<JSON_EOF
{
    "name": "$(basename "$TARGET")/site",
    "description": "Zero CMS sub-project",
    "repositories": [
        {
            "type": "vcs",
            "url": "${REMOTE}"
        }
    ],
    "require": {
        "${PACKAGE_NAME}": "dev-${BRANCH}"
    },
    "config": {
        "secure-http": true
    }
}
JSON_EOF

echo "-> Running composer install (clones Core into ${VENDOR_DIR}/)"
composer install --working-dir "$TARGET" --no-interaction

# --- 2. Scaffold the sub-project's own folder structure ---
echo "-> Creating sub-project folder structure"
mkdir -p "$TARGET"/public/assets
mkdir -p "$TARGET"/src/Controllers
mkdir -p "$TARGET"/src/Models
mkdir -p "$TARGET"/src/Views
mkdir -p "$TARGET"/src/Support
mkdir -p "$TARGET"/src/Modules/Records/Database/Migrations
mkdir -p "$TARGET"/tests
mkdir -p "$TARGET"/storage/private
mkdir -p "$TARGET"/storage/logs
mkdir -p "$TARGET"/bin
touch "$TARGET"/storage/private/.gitkeep "$TARGET"/storage/logs/.gitkeep

# --- 3. Generate the front controller ---
cat > "$TARGET/public/index.php" <<PHP_EOF
<?php
/**
 * public/index.php
 * Front Controller and Autoloader bootstrapper for this sub-project.
 */

use Zero\Core\App;
use Zero\Core\Env;
use Zero\Core\Storage\Storage;

define('REQUEST_START_TIME', microtime(true));

// 1. Define folder paths relative to Sub-project root
define('SUBPROJECT_ROOT', dirname(__DIR__));

// Zero CMS Core is installed by Composer at a fixed, deterministic vendor path -- no fallback
// path-detection needed, unlike the old git-submodule bootstrap.
define('APPLICATION_ROOT', SUBPROJECT_ROOT . '/${VENDOR_DIR}');
define('CORE_ROOT', APPLICATION_ROOT);
define('APP_ROOT', SUBPROJECT_ROOT);
define('VIEWS_DIR', SUBPROJECT_ROOT . '/src/Views'); // Custom sub-project view overrides directory

// 2. Register the Zero Core (Zero\ -> CORE_ROOT/src) and Sub-Project (App\ -> APP_ROOT/src)
// namespace autoloaders via Core's shared Autoloader. Autoloader itself is the one class this
// project always references fully-qualified: it must be require()'d and invoked before any
// autoloading exists at all, so there's nothing a \`use\` import could resolve yet.
require_once CORE_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();
\Zero\Core\Autoloader::registerNamespace('App\\\\', APP_ROOT . '/src');

// Keep all local storage (public tenant uploads, private files) physically inside this
// sub-project's own root instead of the read-only vendor package -- paired with
// bin/setup-symlinks, which points public/storage at ../storage so public URLs stay stable.
Storage::setRoot(APP_ROOT);

// Let this sub-project's own src/Modules/ contribute modules and migrations the same way
// Core's own src/Modules/ does (see bin/seed and src/Modules/Records/Database/Migrations/
// for a real example) -- must be registered before App::bootstrap().
App::registerModulePath(APP_ROOT . '/src/Modules', 'App\\\\Modules\\\\');

// Load environment configuration from this sub-project's own root
Env::load(APP_ROOT);

// Security Hardening: Configure error reporting based on Environment settings
if (Env::get('ENVIRONMENT') === 'production') {
    ini_set('display_errors', '0');
    error_reporting(0);
} else {
    ini_set('display_errors', '1');
    error_reporting(E_ALL);
}

// Bootstrap Multi-Tenant CMS (Automatically boots and configures the isolated system)
App::bootstrap();

// Register the sub-project view override folder to enable zero-touch theme/layout overrides
App::registerViewDir('app', VIEWS_DIR);

// Resolve and render the homepage for '/', dispatch dynamic/admin routes, and fall back to
// serving static assets directly from this sub-project's own public/ directory -- shared with
// Core's own public/index.php via App::handleRequest(), so this sub-project automatically gets
// the same admin-route and static-asset fallback behavior instead of a hand-copied duplicate.
App::handleRequest(__DIR__);
PHP_EOF

# --- 4. Generate the test bootstrap + runner ---
cat > "$TARGET/tests/bootstrap.php" <<PHP_EOF
<?php
/**
 * tests/bootstrap.php
 * Common bootstrapping and namespace autoloader for sub-project tests.
 */

use App\Support\TestRunner;
use Zero\Core\App;
use Zero\Core\Env;
use Zero\Core\Storage\Storage;

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

define('SUBPROJECT_ROOT', dirname(__DIR__));
define('APPLICATION_ROOT', SUBPROJECT_ROOT . '/${VENDOR_DIR}');
define('CORE_ROOT', APPLICATION_ROOT);
define('APP_ROOT', SUBPROJECT_ROOT);
define('TEST_SUITE_RUNNING', true);

require_once CORE_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();
\Zero\Core\Autoloader::registerNamespace('App\\\\', APP_ROOT . '/src');
Storage::setRoot(APP_ROOT);
App::registerModulePath(APP_ROOT . '/src/Modules', 'App\\\\Modules\\\\');

Env::load(APP_ROOT);

// Force the test suite onto an isolated database instead of the real one.
try {
    \$reflector = new ReflectionClass(Env::class);
    \$property = \$reflector->getProperty('data');
    \$property->setAccessible(true);
    \$data = \$property->getValue();

    \$originalDbName = \$data['DB_NAME'] ?? 'cms';
    \$testDbName = \$originalDbName . '_subproject_test';

    if (\$workerToken = getenv('TEST_TOKEN')) {
        \$testDbName .= '_' . \$workerToken;
    }

    \$data['DB_NAME'] = \$testDbName;
    \$data['STORAGE_DRIVER'] = 'local';
    \$property->setValue(null, \$data);
} catch (Exception \$e) {
    echo "Warning setting up test database override: " . \$e->getMessage() . "\n";
}

/**
 * Light-weight test assertion helper. Delegates to App\Support\TestRunner so every test file's
 * assert_test() call and this sub-project's bin/test share the exact same pass/fail behavior.
 */
function assert_test(bool \$condition, string \$message) {
    TestRunner::assertTest(\$condition, \$message);
}
PHP_EOF

cat > "$TARGET/src/Support/TestRunner.php" <<'PHP_EOF'
<?php
/**
 * src/Support/TestRunner.php
 * Discovers and runs all tests/*Test.php files sequentially, each in its own subprocess.
 */

namespace App\Support;

class TestRunner
{
    /**
     * Discover, run, and report on every *Test.php file under $testsRoot. Echoes progress
     * directly and returns the process exit code (0 on full success, 1 if any suite failed).
     *
     * @param string $testsRoot
     * @return int
     */
    public static function run(string $testsRoot): int
    {
        $testFiles = glob($testsRoot . '/*Test.php');
        sort($testFiles);

        echo "==================================================\n";
        echo "       SUB-PROJECT UNIT TEST RUNNER          \n";
        echo "==================================================\n\n";

        if (empty($testFiles)) {
            echo "No test files found matching *Test.php.\n";
            return 0;
        }

        echo "Found " . count($testFiles) . " test suite file(s).\n\n";

        $passed = 0;
        $failed = 0;
        $failedSuites = [];

        foreach ($testFiles as $file) {
            $suiteName = basename($file);
            echo "Running {$suiteName}...\n";

            exec("php " . escapeshellarg($file), $output, $exitCode);
            foreach ($output as $line) {
                echo "  " . $line . "\n";
            }

            if ($exitCode === 0) {
                $passed++;
                echo "--> {$suiteName} PASSED\n\n";
            } else {
                $failed++;
                $failedSuites[] = $suiteName;
                echo "--> {$suiteName} FAILED\n\n";
            }
            $output = [];
        }

        echo "==================================================\n";
        echo "Passed: {$passed}   Failed: {$failed}\n";
        echo "==================================================\n";

        if ($failed > 0) {
            foreach ($failedSuites as $suite) {
                echo "  - {$suite}\n";
            }
            return 1;
        }
        return 0;
    }

    /**
     * Light-weight test assertion helper, called by every test file via the global assert_test()
     * wrapper defined in tests/bootstrap.php. Exits the current subprocess with status code 1 on
     * failure, which is what run()'s exit-code-based pass/fail detection relies on.
     *
     * @param bool $condition
     * @param string $message
     * @return void
     */
    public static function assertTest(bool $condition, string $message): void
    {
        if ($condition) {
            echo "  \033[32m\xE2\x9C\x85 PASS:\033[0m {$message}\n";
        } else {
            echo "  \033[31m\xE2\x9D\x8C FAIL:\033[0m {$message}\n";
            exit(1);
        }
    }
}
PHP_EOF

cat > "$TARGET/bin/test" <<PHP_EOF
#!/usr/bin/env php
<?php
/**
 * bin/test
 * Discovers and runs all *Test.php files under tests/ via App\Support\TestRunner.
 */

define('SUBPROJECT_ROOT', dirname(__DIR__));
define('APPLICATION_ROOT', SUBPROJECT_ROOT . '/${VENDOR_DIR}');
define('CORE_ROOT', APPLICATION_ROOT);
define('APP_ROOT', SUBPROJECT_ROOT);

require_once CORE_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();
\Zero\Core\Autoloader::registerNamespace('App\\\\', APP_ROOT . '/src');

use App\Support\TestRunner;

exit(TestRunner::run(APP_ROOT . '/tests'));
PHP_EOF
chmod +x "$TARGET/bin/test"

cat > "$TARGET/tests/ExampleTest.php" <<'PHP_EOF'
<?php
/**
 * tests/ExampleTest.php
 * Example unit test verifying the sub-project's own model and controller load correctly.
 */

use App\Controllers\HomeController;
use App\Models\CustomModel;
use Zero\Interfaces\Controller;

require_once __DIR__ . '/bootstrap.php';

$config = CustomModel::getConfig();
assert_test(is_array($config), "CustomModel::getConfig() returns an array");
assert_test(isset($config['name']) && $config['name']['required'] === true, "CustomModel 'name' field is required");

$controller = new HomeController();
assert_test($controller instanceof Controller, "HomeController implements Zero\\Interfaces\\Controller");

echo "Example sub-project tests completed.\n";
PHP_EOF

# --- 5. Generate the example migration and the seed script ---
cat > "$TARGET/src/Modules/Records/Database/Migrations/0001_CreateCustomRecordsTable.php" <<'PHP_EOF'
<?php
/**
 * src/Modules/Records/Database/Migrations/0001_CreateCustomRecordsTable.php
 * Example migration for this sub-project's own schema. Discovered automatically by
 * Zero\Database\MigrationManager because public/index.php (and tests/bootstrap.php, bin/seed)
 * register src/Modules/ as a module search path via App::registerModulePath() -- the same
 * mechanism Core's own bundled modules use for their migrations. Add more modules here the
 * same way (SomeName/Database/Migrations/000N_Whatever.php) and they'll be picked up the same way.
 */

namespace App\Modules\Records\Database\Migrations;

use Zero\Database\DB;
use Zero\Database\Migration;

class CreateCustomRecordsTable extends Migration
{
    public function up(): void
    {
        echo "Creating custom_records table...\n";
        DB::query("CREATE TABLE IF NOT EXISTS custom_records (
            id VARCHAR(36) PRIMARY KEY,
            site_id VARCHAR(36) NOT NULL,
            name VARCHAR(255) NOT NULL,
            description TEXT NULL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
            deleted_at DATETIME NULL,
            INDEX (site_id)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;");
    }

    public function down(): void
    {
        echo "Dropping custom_records table...\n";
        DB::query("DROP TABLE IF EXISTS custom_records;");
    }
}
PHP_EOF

cat > "$TARGET/bin/seed" <<PHP_EOF
#!/usr/bin/env php
<?php
/**
 * bin/seed
 * Runs every pending migration (Core's own, plus this sub-project's own modules under
 * src/Modules, e.g. src/Modules/Records/Database/Migrations) and seeds an example record.
 */

use App\Models\CustomModel;
use Zero\Core\App;
use Zero\Core\Env;
use Zero\Core\Storage\Storage;
use Zero\Database\MigrationManager;

define('SUBPROJECT_ROOT', dirname(__DIR__));
define('APPLICATION_ROOT', SUBPROJECT_ROOT . '/${VENDOR_DIR}');
define('CORE_ROOT', APPLICATION_ROOT);
define('APP_ROOT', SUBPROJECT_ROOT);

require_once CORE_ROOT . '/src/Core/Autoloader.php';
\Zero\Core\Autoloader::init();
\Zero\Core\Autoloader::registerNamespace('App\\\\', APP_ROOT . '/src');
Storage::setRoot(APP_ROOT);
App::registerModulePath(APP_ROOT . '/src/Modules', 'App\\\\Modules\\\\');

Env::load(APP_ROOT);
App::bootstrap();

echo "====================================================================\n";
echo "SUB-PROJECT SETUP: MIGRATE + SEED\n";
echo "====================================================================\n\n";

try {
    echo "Running migrations (Core + this sub-project's own)...\n";
    MigrationManager::up();
    echo "Migrations up to date.\n\n";

    \$siteId = App::getCurrentSiteId();
    if (!empty(\$siteId)) {
        echo "Seeding an example record...\n";
        (new CustomModel(['site_id' => \$siteId, 'name' => 'First Custom Record', 'description' => 'Seeded example record.']))->save();
        echo "Done.\n";
    } else {
        echo "No active site tenant resolved for this HTTP_HOST -- skipping example record seed.\n";
        echo "(Register a site for this domain in the admin back-office first.)\n";
    }

    echo "\n\xE2\x9C\x85 SETUP COMPLETE\n";
} catch (\Exception \$e) {
    echo "\n\xE2\x9D\x8C FAILED: " . \$e->getMessage() . "\n";
    exit(1);
}
PHP_EOF
chmod +x "$TARGET/bin/seed"

# --- 6. Generate an example controller, model, and views ---
cat > "$TARGET/src/Controllers/HomeController.php" <<'PHP_EOF'
<?php
/**
 * src/Controllers/HomeController.php
 * Example route controller for this sub-project's homepage.
 */

namespace App\Controllers;

use Zero\Interfaces\Controller;
use Zero\Core\App;
use App\Models\CustomModel;

class HomeController implements Controller
{
    public function handle($param)
    {
        $records = [];
        try {
            $records = CustomModel::all();
        } catch (\Exception $e) {
            // Table might not be migrated yet -- run bin/seed
        }

        // Note the 'app/' prefix: this is what App::registerViewDir('app', VIEWS_DIR) in
        // public/index.php maps to this sub-project's own src/Views/ directory.
        App::render('app/home', [
            'message' => 'Welcome to your new Zero CMS sub-project!',
            'records' => $records
        ]);
        exit;
    }
}
PHP_EOF

cat > "$TARGET/src/Models/CustomModel.php" <<'PHP_EOF'
<?php
/**
 * src/Models/CustomModel.php
 * Example Active Record model for this sub-project.
 */

namespace App\Models;

use Zero\Interfaces\Model;
use Zero\Models\Traits\IsModel;

class CustomModel implements Model
{
    use IsModel;

    protected static $tableName = 'custom_records';
    protected static $modelType = 'CustomRecord';
    protected static $fillable = ['site_id', 'name', 'description'];

    public $id;
    public $site_id;
    public $name;
    public $description;
    public $created_at;
    public $updated_at;
    public $deleted_at;

    public static function getConfig(): array
    {
        return [
            'id' => ['type' => 'int', 'label' => 'ID', 'editable' => false, 'listDisplay' => false],
            'name' => ['type' => 'text', 'label' => 'Record Name', 'editable' => true, 'required' => true, 'listDisplay' => true, 'searchable' => true],
            'description' => ['type' => 'textarea', 'label' => 'Description', 'editable' => true, 'required' => false, 'listDisplay' => true],
            'created_at' => ['type' => 'datetime', 'label' => 'Created At', 'editable' => false, 'listDisplay' => true],
        ];
    }
}
PHP_EOF

cat > "$TARGET/src/Views/layout.php" <<'PHP_EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sub-Project</title>
</head>
<body>
    <?php echo $content ?? ''; ?>
</body>
</html>
PHP_EOF

cat > "$TARGET/src/Views/home.php" <<'PHP_EOF'
<?php
/**
 * src/Views/home.php
 * Example home view for this sub-project.
 */

use Zero\Support\Str;
?>
<div class="custom-home-container">
    <header>
        <h1><?php echo Str::escape($message ?? 'Welcome!'); ?></h1>
    </header>
    <main>
        <h2>Custom Sub-Project Records</h2>
        <?php if (!empty($records)): ?>
            <ul>
                <?php foreach ($records as $record): ?>
                    <li>
                        <strong><?php echo Str::escape($record->name); ?></strong>:
                        <span><?php echo Str::escape($record->description ?? '(No description)'); ?></span>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <p>No custom records found yet. Run <code>bin/seed</code> to create one.</p>
        <?php endif; ?>
    </main>
</div>
PHP_EOF

# --- 7. Generate the asset/storage symlink setup script ---
cat > "$TARGET/bin/setup-symlinks" <<BASH_EOF
#!/bin/sh
# bin/setup-symlinks
# Set up symbolic links pointing from this sub-project's public assets to the Zero Core
# vendor package's own assets, and from public/storage to this sub-project's own storage/
# directory (keeping uploaded files entirely outside the read-only vendor package).
set -e

SUBPROJECT_ROOT=\$(cd "\$(dirname "\$0")/.." && pwd)

echo "Setting up Zero CMS Core asset symlinks..."

mkdir -p "\${SUBPROJECT_ROOT}/public/assets"
mkdir -p "\${SUBPROJECT_ROOT}/storage/private"
mkdir -p "\${SUBPROJECT_ROOT}/storage/logs"

ln -sfn "../../${VENDOR_DIR}/public/assets" "\${SUBPROJECT_ROOT}/public/assets/zero-core"
ln -sfn "../storage" "\${SUBPROJECT_ROOT}/public/storage"

echo "Symlinks established:"
echo "  - Core assets:   public/assets/zero-core/"
echo "  - Public uploads: public/storage/ -> storage/"
BASH_EOF
chmod +x "$TARGET/bin/setup-symlinks"

# --- 8. Environment configuration ---
if [ -f "$TARGET/$VENDOR_DIR/.env.example" ]; then
    cp "$TARGET/$VENDOR_DIR/.env.example" "$TARGET/.env"
    echo "-> Copied ${VENDOR_DIR}/.env.example to .env (edit DB credentials before running the seeder)"
fi

# --- 9. .gitignore ---
cat > "$TARGET/.gitignore" <<'GITIGNORE_EOF'
.env
/vendor/
storage/private/*
storage/logs/*
!storage/private/.gitkeep
!storage/logs/.gitkeep
GITIGNORE_EOF

# --- 10. README ---
cat > "$TARGET/README.md" <<README_EOF
# Sub-Project

This project requires Zero CMS Core via Composer as \`${PACKAGE_NAME}\`, installed at
\`${VENDOR_DIR}/\` and kept entirely separate from this sub-project's own code, views,
storage, and uploads.

## Finish setup

1. Set up asset/storage symlinks (already run once by the scaffold script; re-run any time):
   \`\`\`
   ./bin/setup-symlinks
   \`\`\`
2. Edit \`.env\` with your real database credentials.
3. Run every pending migration (Core's own, plus this sub-project's own under
   \`src/Modules/*/Database/Migrations/\`) and seed an example record:
   \`\`\`
   bin/seed
   \`\`\`
4. Run the test suite:
   \`\`\`
   bin/test
   \`\`\`
5. Point your web server's document root at \`public/\`, or for local dev:
   \`\`\`
   php -S localhost:8000 public/index.php
   \`\`\`

## Layout

- \`${VENDOR_DIR}/\` -- Zero CMS Core (read-only Composer package; do not edit in place)
- \`public/\` -- this sub-project's document root
- \`src/Controllers\`, \`src/Models\`, \`src/Views\` -- your own simple code (namespace \`App\\\`)
- \`src/Modules/Records\` -- an example self-contained module (own migration under
  \`Database/Migrations/\`), showing how to add real modules the same way Core's own
  bundled modules are structured -- add more alongside it the same way
- \`bin/seed\`, \`bin/test\`, \`tests/\` -- your own setup script, test runner, and tests
- \`storage/\` -- private files and logs, kept outside \`${VENDOR_DIR}/\`

## Updating Core

\`\`\`
composer update ${PACKAGE_NAME}
\`\`\`

\`composer.lock\` pins the installed Core version -- commit it alongside \`composer.json\` so
teammates and deploys reproduce the same \`${VENDOR_DIR}/\` checkout via \`composer install\`.
\`vendor/\` itself is gitignored and rebuilt from the lock file, not committed.
README_EOF

# --- 11. Run the symlink setup now, then stage everything ---
echo "-> Running bin/setup-symlinks"
( cd "$TARGET" && ./bin/setup-symlinks )

echo "-> Staging all generated files"
git -C "$TARGET" add -A

echo
echo "==================================================================="
echo " Done. Sub-project scaffolded at: $TARGET"
echo "==================================================================="
echo
echo "Next steps:"
echo "  cd $TARGET"
echo "  \$EDITOR .env                 # set your real DB credentials"
echo "  bin/seed                      # migrate Core + this sub-project's tables, seed an example"
echo "  bin/test                      # run the sub-project test suite"
echo "  git commit -m 'Initial sub-project scaffold'"
echo

# --- 12. Self-delete: this script's one job was to bootstrap $TARGET, and it's done.
# Only reached if every step above succeeded (set -e aborts earlier otherwise), and only
# removes a real, ordinary file at the path resolved before any 'cd' happened above.
if [ -f "$SELF_PATH" ] && [ ! -L "$SELF_PATH" ]; then
    echo "-> Removing this bootstrap script ($SELF_PATH), its job is done"
    rm -f -- "$SELF_PATH"
fi
