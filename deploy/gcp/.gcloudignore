# ==============================================================================
# ZERO CMS - GCLOUD IGNORE RULESET
# ==============================================================================
# Only used for remote builds (USE_LOCAL_DOCKER=false): controls what
# `gcloud builds submit` uploads as the build source. service.sh copies this
# file, the Dockerfile and the .dockerignore into the project root first.
#
# Dockerfile and .dockerignore must NOT be listed here: `gcloud builds submit
# --tag` finds the Dockerfile in the uploaded source (no --config is passed),
# and the remote `docker build` needs .dockerignore in that same upload to
# filter its COPY context the way a local build does. Excluding them breaks
# remote builds. (Found by zero-mobsites' first CI deploy.)
# ==============================================================================

# Git files
.git/
.gitignore

# This file itself, and the deployment toolkits and local dev stack
.gcloudignore
deploy/
deployments/
docker/
docker-compose.yml

# Local configurations, credentials and backups (.deploy/ holds the persisted deployment secrets)
.env
.env.bak
.env.backup
*.bak
.deploy/
*.pem
*-key.json
service-account*.json

# Exclude zip archives and distribution packages
**/*.zip

# Keep system stateless and lightweight
storage/
public/storage/

# Ignore local development/archive folders
_archive/
.vscode/
.github/
.agents/
.claude/
tests/
