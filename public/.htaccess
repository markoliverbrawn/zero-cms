RewriteEngine On
RewriteBase /

# COMPILED THEME STYLESHEETS
# Bundle URLs are content-addressed, so a compiled stylesheet is served straight off disk by
# Apache and only a cache miss -- the first request for that exact combination of source files --
# is rewritten to the front controller, which compiles it, writes it, and streams it back. This
# rule used to be unconditional, which meant every page view's stylesheet request booted PHP just
# to hand back a file already sitting on disk.
RewriteCond %{REQUEST_URI} ^/assets/css/(cache/)?main-[a-zA-Z0-9_\-]+(\.[0-9a-f]+)*\.css$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

# VERSIONED STATIC ASSETS
# Scripts and stylesheets are referenced with a digest of their contents in the filename
# (see Zero\Support\AssetVersion), so they can carry a far-future immutable cache header and
# still be replaceable on deploy. Nothing is generated: the digest is stripped back off here and
# the authored file is served, so no PHP runs and no directory needs to be writable.
# The compiled-bundle names handled above carry two longer hex segments and do not match this.
RewriteRule ^assets/(?!css/cache/)(.+)\.[0-9a-f]{8}\.(js|css)$ assets/$1.$2 [L]

# 0. ON-DEMAND IMAGE VARIANTS (must precede the static whitelist below)
# Generated image renditions live at the exact path their URL describes, so once a variant
# exists Apache serves it directly as a static file and PHP is never invoked. Only a cache
# miss -- the very first request for that specific rendition -- is rewritten to the front
# controller, which renders it, writes it to disk, and streams it back.
RewriteCond %{REQUEST_URI} ^/storage/variants/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

# 1. EXCLUSIVELY WHITELIST web-accessible public asset folders and entry gateways
# (This allows Apache to serve styles, scripts, images, and public uploads directly)
RewriteCond %{REQUEST_URI} !^/assets/ [NC]
RewriteCond %{REQUEST_URI} !^/storage/ [NC]
RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
RewriteCond %{REQUEST_URI} !^/favicon\.ico$ [NC]

# 2. DEFAULT DENY: Forcefully rewrite ALL other paths directly to index.php
# (This shields /src/, /tests/, /etc/, /seeders/, and individual files completely,
# letting index.php front-controller handle routing or return a secure 404)
RewriteRule ^ index.php [L,QSA]

# 3. LEVERAGE BROWSER CACHING (Optimized Cache-Control & Expires Headers for Lighthouse)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Fonts, CSS, and JS (1 Year Cache - highly static)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Images, SVGs, and Favicons (1 Year Cache)
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    
    # Videos (1 Year Cache)
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType video/ogg "access plus 1 year"
    
    # Default fallback (1 Month)
    ExpiresDefault "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Set Cache-Control header for static assets recursively
    <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|gif|webp|ico|svg|mp4|webm|ogv)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 4. GZIP COMPRESSION (Deflate text-compression for Lighthouse)
<IfModule mod_deflate.c>
    # Activate compression filter globally
    SetOutputFilter DEFLATE
    
    # Exclusively compress high-leverage text, code, styling, and vector assets
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    
    # Defensively protect legacy browsers that have known compression issues
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    
    # Ensure proxies and intermediate caches serve the correct asset formats
    <IfModule mod_headers.c>
        Header append Vary User-Agent
    </IfModule>
</IfModule>
